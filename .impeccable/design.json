      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace navigation\"><a href=\"#\">Ticket tracker</a><a href=\"#\" class=\"ds-current\">Work reports</a><a href=\"#\">Connect Codex</a><a href=\"#\">People &amp; access</a><a href=\"#\">Your password</a></nav>",
      "css": ".ds-nav{display:grid;gap:4px;padding:18px;background:var(--sidebar,#18231d);font-family:Inter,ui-sans-serif,system-ui,sans-serif}.ds-nav a{display:block;border-radius:9px;padding:11px 12px;color:#c0ccc3;text-decoration:none;font-size:14px}.ds-nav a:hover{background:rgba(255,255,255,.06);color:white}.ds-nav .ds-current{background:rgba(213,242,221,.12);color:#e3f8e8;font-weight:600}.ds-nav a:focus-visible{outline:3px solid var(--green,#286443);outline-offset:3px}@media(max-width:720px){.ds-nav{display:flex;flex-wrap:wrap;overflow:visible}.ds-nav a{flex:0 0 auto;white-space:nowrap}}"
