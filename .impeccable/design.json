      "css": ".ds-field{display:grid;gap:7px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;font-size:13px;font-weight:600;color:var(--ink,#17211b)}.ds-field input{font:inherit;font-weight:400;max-width:100%;min-height:42px;border:1px solid #bcc8be;border-radius:7px;padding:10px 12px;background:var(--surface,#ffffff);color:var(--ink,#17211b);caret-color:var(--green,#286443);font-variant-numeric:tabular-nums;outline:none}.ds-field input:focus{border-color:#6e9c7e;box-shadow:0 0 0 3px rgba(65,123,84,.1)}.ds-field input:focus-visible{outline:3px solid var(--green,#286443);outline-offset:3px}"
