      "css": ".ds-history{display:grid;gap:8px;width:100%;border:1px solid transparent;background:transparent;text-align:left;padding:13px;border-radius:8px;cursor:pointer;font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:var(--ink,#17211b);font-variant-numeric:tabular-nums}.ds-history:hover{background:var(--line-soft,#edf0ed)}.ds-selected{background:var(--surface,#ffffff);border-color:#a5bca9}.ds-history strong{font-size:12px}.ds-history>span:not(.ds-history-state){font-size:11px;color:var(--muted,#68736c);line-height:1.5}.ds-history-state{font-size:11px;width:fit-content;color:var(--green-dark,#1c4c32);background:var(--green-soft,#e5f2e9);padding:3px 7px;border-radius:4px}.ds-history:focus-visible{outline:3px solid var(--green,#286443);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Incumbent workspace continuity",
    "overview": "This is a record of the built workspace extension, rather than a newly selected visual identity. Its authority is the shared stylesheet and the implemented reports, people, password, Codex setup, and workspace frame. The existing application name and icon remain the identity anchors. Unexamined ticket-tracker surfaces are outside this record.\n\nDark green navigation frames an off-white working canvas. White surfaces, quiet borders, compact controls, and a single green action color support task completion and reading. Reports receive more whitespace and longer line spacing than surrounding controls. The implemented stack names Inter first and falls back to local system UI fonts; the root layout does not load a separate webfont.",
    "keyCharacteristics": [
      "Green actions and selection states within a restrained neutral workspace.",
      "Native date, select, password, and text controls with persistent labels.",
      "Compact navigation and controls around a spacious report document.",
      "Rounded corners, thin borders, and shallow action depth."
    ],
    "rules": [
      {
        "name": "The Labeled State Rule",
        "body": "Status color accompanies a readable state name. Ready, Queued, Generating, and Failed remain explicit text.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use the existing border and surface separation for report containers; reserve the recorded lift for primary actions.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** extend the existing green, off-white, border-led workspace and retained brand assets.",
      "**Do** keep labels, native controls, visible keyboard focus, and readable job-state names.",
      "**Do** use compact controls around the more spacious report reading surface.",
      "**Do** keep all five workspace destinations visible in wrapping mobile rows."
    ],
    "donts": [
      "**Don't** introduce a replacement identity while extending these workspace screens.",
      "**Don't** encode report job state by color alone.",
      "**Don't** print workspace chrome or the initial-password reminder with a report.",
      "**Don't** apply this scoped record to unrelated ticket-tracker patterns without inspecting them."
    ]
  }
}
