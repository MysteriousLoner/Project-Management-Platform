LLM_API_KEY=replace-me
LLM_MODEL=gemma-4
LLM_API_BASE_URL=https://example.invalid/v1
LLM_PROVIDER=openai

# Optional Web Push settings. When keys are blank, 协策达 generates a stable
# VAPID key pair and stores it in PostgreSQL on first use.
WEB_PUSH_SUBJECT=mailto:admin@xieceda.local
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
APP_PORT=3080

# Optional URL prefix when serving behind a shared HTTPS domain.
# NEXT_PUBLIC_BASE_PATH=/xieceda

# Docker Compose supplies the internal service values below.
DATABASE_URL=postgresql://project_manager:change-me@postgres:5432/project_manager
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=project-attachments
S3_ACCESS_KEY=project_manager
S3_SECRET_KEY=change-me
