{
  "name": "local-project-management-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-onboarding.mjs && node scripts/build-next.mjs && node scripts/build-runtime.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx --env-file-if-exists=.env worker/report-worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "test:unit": "vitest run lib/*.test.ts",
    "predev": "node scripts/build-onboarding.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1094.0",
    "@better-auth/cimd": "1.7.15",
    "@better-auth/mcp": "1.7.15",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.15",
    "next": "16.4.4",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  }
}
